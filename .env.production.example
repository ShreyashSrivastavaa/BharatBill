# ══════════════════════════════════════════════════════════════════════════════
# BharatBill Production Environment Variables Reference
# Copy to `.env.production` or set in your container/cloud platform
# ══════════════════════════════════════════════════════════════════════════════

# Database Credentials
POSTGRES_USER=bharatbill
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=bharatbill

# App & Network
PORT_HTTP=80
FRONTEND_URL=https://bharatbill.in
NODE_ENV=production

# JWT Authentication Secrets (Generate using `openssl rand -hex 32`)
JWT_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_hex_secret

# Google OAuth 2.0 Credentials
# (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Razorpay Production Payment Gateway Credentials
# (Obtain from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayLiveSecret

# Super Admin Access
# Hardcoded to authorized administrator email accounts:
